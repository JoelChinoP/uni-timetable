{
	"name": "uni-timetable",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:frontend": "vite",
		"dev:backend": "go -C backend run ./cmd/api",
		"db:seed": "go -C backend run ./cmd/seed",
		"build": "vite build",
		"preview": "vite preview",
		"check": "npm run check:frontend && npm run check:backend",
		"check:frontend": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"check:backend": "go -C backend test ./...",
		"test": "npm run test:frontend && npm run check:backend",
		"test:frontend": "node --test scripts/planner.test.ts",
		"format": "npm run format:frontend && npm run format:backend",
		"format:frontend": "prettier --write .",
		"format:backend": "go -C backend fmt ./...",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.66.0",
		"vercel": "^58.9.0",
		"vite": "^8.2.0"
	}
}
